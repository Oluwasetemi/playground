{
  "name": "code-playground",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "description": "A robust code playground using WebContainers API",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@setemiojo/eslint-config": "^6.2.0",
    "@types/node": "^20.19.30",
    "bumpp": "^10.4.0",
    "eslint": "^9.39.2",
    "turbo": "^2.7.5",
    "typescript": "^5.9.3"
  }
}
