{
  "name": "@setemiojo/playground-vue",
  "type": "module",
  "version": "0.5.0",
  "description": "Vue 3 components for code playground",
  "author": "Oluwasetemi Ojo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oluwasetemi/playground",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./src/styles/playground.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc && vite build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@nanostores/vue": "^1.1.0",
    "@setemiojo/playground-core": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.1",
    "vue": "^3.5.16",
    "vue-tsc": "^2.2.10"
  }
}
