{
  "name": "@setemiojo/playground-react",
  "type": "module",
  "version": "0.5.0",
  "description": "React components for code playground",
  "repository": {
    "type": "git",
    "url": "https://github.com/oluwasetemi/playground",
    "directory": "packages/react"
  },
  "author": "Oluwasetemi Ojo",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
